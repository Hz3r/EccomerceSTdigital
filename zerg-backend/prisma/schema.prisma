// ==================== DATASOURCE & GENERATOR ====================

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==================== ENUMS ====================

enum RolUsuario {
  ADMIN
  CLIENTE
}

enum ProveedorAuth {
  LOCAL
  GOOGLE
}

enum StatusOrden {
  PENDIENTE
  ENVIADO
  COMPLETADO
  CANCELADO
}

enum AudienciaNotificacion {
  ADMIN
  CLIENTE
}

// COMPRA: orden nueva · VENTA: orden completada · PEDIDO: avance del pedido del cliente · RESENA: reseñas
// PAGO: comprobantes y confirmaciones de pago · MENSAJE: chat de soporte
enum TipoNotificacion {
  COMPRA
  VENTA
  PEDIDO
  RESENA
  PAGO
  MENSAJE
}

// DIRECTO: Yape, Plin o transferencia con comprobante (lo revisa el admin)
enum MetodoPago {
  DIRECTO
  IZIPAY
  BINANCE_PAY
}

enum EstadoPago {
  PENDIENTE
  EN_REVISION
  PAGADO
  RECHAZADO
}

enum EstadoConversacion {
  ABIERTA
  CERRADA
}

// WEB: chat de la tienda · WHATSAPP: reservado para conectar la API de WhatsApp más adelante
enum CanalConversacion {
  WEB
  WHATSAPP
}

enum AutorMensaje {
  CLIENTE
  ADMIN
}

// ==================== USUARIO ====================

model User {
  id            String         @id @default(uuid())
  nombre        String
  email         String         @unique
  passwordHash  String?
  googleId      String?        @unique
  proveedor     ProveedorAuth  @default(LOCAL)
  rol           RolUsuario     @default(CLIENTE)
  avatarUrl     String?
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  creadoEn      DateTime       @default(now())
  actualizado   DateTime       @updatedAt
  orders        Order[]
  reviews       Review[]
  notifications Notification[]
  conversations Conversation[]
  favorites     Favorite[]

  @@map("users")
}

// ==================== CATEGORÍAS ====================

model Category {
  id          String    @id @default(uuid())
  nombre      String    @unique
  slug        String    @unique
  descripcion String?
  imagenUrl   String?
  isActive    Boolean   @default(true)
  creadoEn    DateTime  @default(now())
  actualizado DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

// ==================== PRODUCTOS ====================

model Product {
  id          String     @id @default(uuid())
  nombre      String
  slug        String     @unique
  descripcion String?
  imagenUrl   String?
  // Contenido de la página del producto (vacío = se usan los textos generales de la tienda)
  incluye     Json?
  pasos       Json?
  faqs        Json?
  isActivo    Boolean    @default(true)
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id])
  creadoEn    DateTime   @default(now())
  actualizado DateTime   @updatedAt
  plans       Plan[]
  reviews     Review[]
  favorites   Favorite[]

  @@map("products")
}

// ==================== PLANES (VARIANTES) ====================

model Plan {
  id             String      @id @default(uuid())
  nombre         String
  slug           String      @unique
  duracion       String
  precio         Decimal     @db.Decimal(10, 2)
  precioOriginal Decimal?    @db.Decimal(10, 2)
  descripcion    String?
  isActivo       Boolean     @default(true)
  productId      String
  product        Product     @relation(fields: [productId], references: [id])
  creadoEn       DateTime    @default(now())
  actualizado    DateTime    @updatedAt
  orderItems     OrderItem[]

  @@map("plans")
}

// ==================== ORDENES ====================

model Order {
  id            String         @id @default(uuid())
  numeroOrden   String         @unique
  nombreCliente String
  email         String
  telefono      String?
  whatsappLink  String?
  status        StatusOrden    @default(PENDIENTE)
  notas         String?
  total         Decimal        @db.Decimal(10, 2)
  userId        String?
  user          User?          @relation(fields: [userId], references: [id])
  creadoEn      DateTime       @default(now())
  actualizado   DateTime       @updatedAt
  metodoPago    MetodoPago?
  items         OrderItem[]
  notifications Notification[]
  payments      Payment[]

  @@map("orders")
}

// ==================== ITEMS DE ORDEN ====================

model OrderItem {
  id             String      @id @default(uuid())
  cantidad       Int         @default(1)
  precioUnitario Decimal     @db.Decimal(10, 2)
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id])
  planId         String
  plan           Plan        @relation(fields: [planId], references: [id])
  creadoEn       DateTime    @default(now())
  credential     Credential?

  @@map("order_items")
}

// ==================== RESEÑAS ====================

model Review {
  id           String    @id @default(uuid())
  puntuacion   Int
  comentario   String?
  // Respuesta pública de la tienda (la escribe un admin)
  respuesta    String?
  respondidoEn DateTime?
  isApproved   Boolean   @default(false)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  creadoEn     DateTime  @default(now())
  actualizado  DateTime  @updatedAt

  @@unique([productId, userId])
  @@map("reviews")
}

// ==================== CONFIGURACIÓN DEL SITIO (CMS) ====================

// Contenido editable desde el panel admin: marca, header, portada, contacto y pie.
model SiteSetting {
  key         String   @id
  value       Json
  actualizado DateTime @updatedAt

  @@map("site_settings")
}

// ==================== NOTIFICACIONES ====================

// Avisos del admin (audiencia ADMIN, compartidos entre administradores) y de cada cliente (audiencia CLIENTE + userId).
model Notification {
  id        String                @id @default(uuid())
  audiencia AudienciaNotificacion
  tipo      TipoNotificacion
  titulo    String
  mensaje   String
  href      String?
  leida     Boolean               @default(false)
  userId    String?
  user      User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  creadoEn  DateTime              @default(now())

  @@index([audiencia, userId, creadoEn])
  @@map("notifications")
}

// ==================== PAGOS ====================

// Un intento de pago de una orden. El pago directo lo confirma el admin; Izipay y Binance Pay, su webhook.
model Payment {
  id            String     @id @default(uuid())
  orderId       String
  order         Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  metodo        MetodoPago
  estado        EstadoPago @default(PENDIENTE)
  monto         Decimal    @db.Decimal(10, 2)
  moneda        String     @default("PEN")
  // N.º de operación (Yape/Plin/transferencia) o id de transacción del proveedor
  referencia    String?
  // Archivo privado del comprobante (no se sirve en /api/uploads)
  comprobante   String?
  motivoRechazo String?
  // Respuesta del proveedor (sin datos de tarjeta), para auditoría
  detalle       Json?
  creadoEn      DateTime   @default(now())
  actualizado   DateTime   @updatedAt

  @@index([orderId])
  @@map("payments")
}

// ==================== CHAT DE SOPORTE ====================

// Conversación iniciada desde la tienda (con o sin cuenta). `tema` es la "entrada" elegida por el cliente.
model Conversation {
  id               String             @id @default(uuid())
  tema             String
  nombre           String
  email            String?
  telefono         String?
  canal            CanalConversacion  @default(WEB)
  estado           EstadoConversacion @default(ABIERTA)
  userId           String?
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Hash del token que guarda el navegador del visitante para volver a su chat
  tokenHash        String             @unique
  // Número de WhatsApp del cliente (solo dígitos) en chats que llegan por WhatsApp Business
  waId             String?            @unique
  // Último mensaje del cliente: WhatsApp solo deja responder con texto libre durante 24 h
  ultimoEntranteEn DateTime?
  noLeidasAdmin    Int                @default(0)
  noLeidasCliente  Int                @default(0)
  ultimoMensajeEn  DateTime           @default(now())
  messages         Message[]
  creadoEn         DateTime           @default(now())

  @@index([estado, ultimoMensajeEn])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  autor          AutorMensaje
  texto          String
  // Id del mensaje en WhatsApp (evita duplicados si Meta reenvía el webhook)
  waMessageId    String?      @unique
  creadoEn       DateTime     @default(now())

  @@index([conversationId, creadoEn])
  @@map("messages")
}

// ==================== FAVORITOS ====================

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  creadoEn  DateTime @default(now())

  @@id([userId, productId])
  @@map("favorites")
}

// ==================== CREDENCIALES (ENTREGA DEL SERVICIO) ====================

// Accesos entregados por cada ítem de una orden. `datos` va cifrado (AES-256-GCM con CREDENTIALS_KEY).
model Credential {
  id                String    @id @default(uuid())
  orderItemId       String    @unique
  orderItem         OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  datos             String
  venceEn           DateTime?
  // Visible en "Mis accesos" de la tienda desde que el admin la publica
  publicadoEn       DateTime?
  // Canales por los que ya se envió
  enviadoCorreoEn   DateTime?
  enviadoWhatsappEn DateTime?
  vistoEn           DateTime?
  creadoEn          DateTime  @default(now())
  actualizado       DateTime  @updatedAt

  @@map("credentials")
}
