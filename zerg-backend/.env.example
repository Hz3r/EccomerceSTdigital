# Copia este archivo como .env y ajusta los valores
# PostgreSQL (en Laragon: usuario postgres, puerto 5432)
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/zerg
JWT_SECRET=cambia-esto-por-un-texto-largo-y-secreto
PORT=3001
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
RATE_LIMIT_MAX=1000
# Inicio de sesión con Google: Client ID de tipo "Aplicación web" de Google Cloud
# (Google Auth Platform → Clientes). Es público (la tienda lo envía al navegador).
# No se usa el client secret: nunca lo pongas aquí. Vacío = el botón de Google no se muestra.
GOOGLE_CLIENT_ID=953445082400-97v3hgavtmk51djviit39krif65siv50.apps.googleusercontent.com

# ==================== PAGOS ====================
# URL pública del backend (para que Binance Pay envíe su webhook). En local puedes usar un túnel (ngrok, devtunnels).
BACKEND_PUBLIC_URL=

# Izipay (tarjetas): Back Office Vendedor → Configuración → Tienda → Claves de API REST.
# Vacío = el método "Tarjeta (Izipay)" se muestra como "Próximamente".
# URL de notificación (IPN) a registrar en Izipay: <BACKEND_PUBLIC_URL>/api/payments/webhooks/izipay
IZIPAY_USERNAME=
IZIPAY_PASSWORD=
IZIPAY_PUBLIC_KEY=
IZIPAY_HMAC_KEY=

# Binance Pay Merchant (cripto, USDT): merchant.binance.com → Developers → API Key.
# Vacío = el método "Binance Pay" se muestra como "Próximamente".
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET=

# ==================== CREDENCIALES ====================
# Clave para cifrar los accesos que entregas a los clientes (texto largo y aleatorio).
# Si la cambias, las credenciales ya guardadas dejan de poder leerse. Vacío = se deriva de JWT_SECRET.
CREDENTIALS_KEY=

# Correo (Resend, resend.com): API key y remitente de un dominio verificado. Vacío = no se envía por correo.
RESEND_API_KEY=
EMAIL_FROM="ZERG <accesos@tudominio.com>"

# ==================== WHATSAPP BUSINESS (Cloud API de Meta) ====================
# developers.facebook.com → tu app → WhatsApp → Configuración de la API.
# Webhook a registrar en Meta: <BACKEND_PUBLIC_URL>/api/whatsapp/webhook (suscribe el campo "messages").
# Vacío = el chat sigue funcionando solo por la web y el botón abre WhatsApp normal.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Texto que tú inventas y pegas igual en Meta al registrar el webhook
WHATSAPP_VERIFY_TOKEN=
# Configuración de la app → Básica → Clave secreta de la app (para verificar la firma del webhook)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_COUNTRY_CODE=51
WHATSAPP_TEMPLATE_LANGUAGE=es
# Plantillas aprobadas para escribir fuera de la ventana de 24 h (opcionales):
# respuesta: {{1}} = texto de la respuesta del admin
WHATSAPP_TEMPLATE_REPLY=
# credenciales: {{1}} = nombre, {{2}} = n.º de pedido, {{3}} = accesos
WHATSAPP_TEMPLATE_CREDENTIALS=
